# Public service
DOMAIN=http://localhost
HOST=127.0.0.1
TRUST_LOOPBACK_PROXY=false
PORT=8080
DB_PATH=/data/astra-v2.db
PAPER_TRADING=true
# Live is disabled in v2.1. Do not use real broker keys for Paper staging.
WORKER_INTERVAL_MS=250
# Optional Phase 2 runtime (npm run start:postgres + npm run worker:postgres).
# Never point the import/tests at a live database. PostgreSQL 16+; private network only.
# DATABASE_URL=postgresql://robot:URL_ENCODED_PASSWORD@127.0.0.1:5432/robot
PG_POOL_SIZE=5

# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace-with-64-hex-characters
SESSION_TTL_HOURS=24
SESSION_IDLE_MINUTES=30
# Exact browser origin, without a path. HTTPS is required except on loopback.
PUBLIC_ORIGIN=http://127.0.0.1:8080
ENCRYPTION_KEY_ID=k1
# Retained versioned keys during rotation only; JSON object keyed by key ID.
ENCRYPTION_PREVIOUS_KEYS={}

# First boot only. Change/remove the password after the admin account is created.
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-immediately

# Optional email notifications (SMTP SSL on port 465 or STARTTLS on 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Robot trade <bot@example.com>

# Default risk profile for new users
MAX_RISK_PERCENT=100
MAX_ORDER_NOTIONAL=10000
MAX_DAILY_NOTIONAL=100000
MAX_TRADES_PER_DAY=10
MAX_DAILY_LOSS_R=3
MAX_OPEN_POSITIONS=3
PAUSE_AFTER_LOSS_STREAK=3
MAX_SIGNAL_AGE_SECONDS=60
MAX_VOLATILITY_PERCENT=5
BLOCK_HIGH_VOLATILITY=true
BLOCK_DURING_NEWS=true
SIDE_MODE=BOTH
REQUIRE_REDUCE_ONLY_SELL=true

# APP-3A draft builder: disabled until isolated extension migration/acceptance.
PINE_BRIDGE_ENABLED=0
# Initial direct API adapter: gpt-4.1, gpt-4.1-mini or gpt-4.1-nano.
# Set explicit reviewed model rates; absent rates block provider dispatch.
PINE_AI_MODEL=
PINE_AI_API_KEY=
PINE_AI_INPUT_USD_PER_MILLION=
PINE_AI_OUTPUT_USD_PER_MILLION=
PINE_AI_RATE_VERSION=
