# Console API key from the organization linked to your Max plan
# (platform.claude.com -> API keys). Create it in a dedicated workspace
# with a spend limit. Never commit .env.
ANTHROPIC_API_KEY=

# claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5. Switchable in the chat.
CHAT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Higher effort is more thorough and costs more.
CHAT_EFFORT=high
# Per-run safety stop in USD (client-side estimate). The workspace spend limit is the hard cap.
CHAT_MAX_BUDGET_USD=5
# Optional stop for the whole chat in USD (client-side estimate, all runs added up).
CHAT_MAX_SESSION_USD=
# default (ask before every edit) | acceptEdits (default for npm start) | plan. Handoff always uses default.
CHAT_PERMISSION_MODE=acceptEdits

# Repository Claude works in. Empty means the repository that contains this tool.
CHAT_REPO_DIR=
# Keep 127.0.0.1. Any other host is refused unless CHAT_ALLOW_REMOTE=1.
# For phone access use an SSH tunnel on the same port or a private network; never the public internet.
CHAT_HOST=127.0.0.1
CHAT_PORT=8787
CHAT_ALLOW_REMOTE=
# Extra Host header values (name:port, comma separated) for a private network name.
CHAT_ALLOWED_HOSTS=
# Set to 0 to keep the access link (it holds the token) out of the output. Handoff sets this.
CHAT_PRINT_URL=
# Optional fixed access token (at least 24 characters) so the browser link survives restarts.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CHAT_TOKEN=