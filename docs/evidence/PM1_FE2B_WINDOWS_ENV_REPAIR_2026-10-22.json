  "rootCause": {
    "summary": "libuv adds its required Windows variables to an explicit child environment when omitted. Ten non-allowlisted parent values reached Python. The failed exact-key assertion revealed this behavior.",
    "source": "https://github.com/libuv/libuv/blob/v1.52.1/src/win/process.c#L47-L59",
    "inheritanceSource": "https://github.com/libuv/libuv/blob/v1.52.1/src/win/process.c#L592-L605",
