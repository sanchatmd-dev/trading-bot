        label.set_text(labTP1, "TP1 " + f_price(tradeTP1))

    if not na(labTP2)
        label.set_x(labTP2, rightX)
        label.set_y(labTP2, tradeTP2)
        label.set_text(labTP2, "TP2 " + f_price(tradeTP2))

    if not na(labTP3)
        label.set_x(labTP3, rightX)
        label.set_y(labTP3, tradeTP3)
        label.set_text(labTP3, "TP3 " + f_price(tradeTP3))

    if not na(labTP4)
        label.set_x(labTP4, rightX)
        label.set_y(labTP4, tradeTP4)
        label.set_text(labTP4, "TP4 " + f_price(tradeTP4))

    if not na(labTP5)
        label.set_x(labTP5, rightX)
        label.set_y(labTP5, tradeTP5)
