//====================================================
// ALERTS
//====================================================

alertcondition(
     buySignal,
     title = "SPT PRO BUY",
     message = "SPT PRO BUY on {{ticker}} {{interval}}"
)

alertcondition(
     sellSignal,
     title = "SPT PRO SELL",
     message = "SPT PRO SELL on {{ticker}} {{interval}}"
)

alertcondition(
     tp1HitNow,
     title = "SPT PRO TP1 Hit",
     message = "SPT PRO TP1 hit on {{ticker}} {{interval}}"
)

alertcondition(
     tp2HitNow,
     title = "SPT PRO TP2 Hit",
     message = "SPT PRO TP2 hit on {{ticker}} {{interval}}"
)

alertcondition(
     tp3HitNow,
     title = "SPT PRO TP3 Hit",
     message = "SPT PRO TP3 hit on {{ticker}} {{interval}}"
)

alertcondition(
     tp4HitNow,
     title = "SPT PRO TP4 Hit",
     message = "SPT PRO TP4 hit on {{ticker}} {{interval}}"
)

alertcondition(
     tp5HitNow,
     title = "SPT PRO TP5 Hit",
     message = "SPT PRO TP5 hit on {{ticker}} {{interval}}"
)

alertcondition(
     slHitNow,
     title = "SPT PRO SL Hit",
     message = "SPT PRO SL hit on {{ticker}} {{interval}}"
)

// ROBOT TRADE BRIDGE BEGIN
// Transport state only: does not change SPT signals, drawings or backtest.
// One dedicated Spot paper bot per alert. Start/recreate alerts only when flat.
groupRobot = "11. Robot Trade - Spot Paper"
rtBuild = input.string("1.3.0", "Robot Bridge version", options = ["1.3.0"], group = groupRobot)
rtTag = input.string("spt1", "Unique alert deployment ID (1-12 letters/digits)", group = groupRobot)
rtBroker = input.string("Binance Global", "Broker", options = ["Binance Global", "Binance TH", "InnovestX", "Settrade"], group = groupRobot)
rtRisk = input.float(0.5, "Risk per BUY (% equity; server limits still apply)", minval = 0.01, maxval = 100, step = 0.1, group = groupRobot)
rtExitOnSell = input.bool(true, "Send SELL as reduce-only (server checks holdings)", group = groupRobot)
rtNews = input.bool(false, "Manually block BUY for news (not a news feed)", group = groupRobot)
rtRepeatBuy = input.bool(true, "Send repeated BUY signals (server risk limits apply)", group = groupRobot)
rtShowSkipped = input.bool(true, "Show skipped BUY/SELL reason on chart", group = groupRobot)
rtShowStatus = input.bool(true, "Show Robot Bridge status (chart instance only)", group = groupRobot)
rtEnabled = notifyEnabled and notifyExtra == "Robot Trade (Spot)"
if barstate.isfirst and rtEnabled
    if str.length(rtTag) < 1 or str.length(rtTag) > 12 or str.match(rtTag, "^[A-Za-z0-9]+$") != rtTag
        runtime.error("Robot Trade: deployment ID must be 1-12 letters/digits.")
    if not chart.is_standard
        runtime.error("Robot Trade: use standard candles, not synthetic charts.")

// Price strings preserve decimal precision through the PostgreSQL normalizer.
f_rtPayload(string ev, float px, float stop, float target, float vol, int stamp, string targetTradeId = "") =>
    string id = "SPT-" + rtTag + "-" + syminfo.ticker + "-" + timeframe.period + "-" + str.tostring(stamp) + "-" + ev + (targetTradeId != "" ? ("-" + targetTradeId) : "")
    if str.length(id) > 80
        runtime.error("Robot Trade: trade_id exceeds 80 characters.")
    string riskPart = ev == "BUY" ? ',"risk_mode":"PERCENT_EQUITY","risk_value":"' + str.tostring(rtRisk, "0.########") + '","stop_loss":"' + str.tostring(stop, format.mintick) + '","take_profit":"' + str.tostring(target, format.mintick) + '"' : ',"risk_mode":"QUANTITY"'
    string targetPart = targetTradeId != "" ? ',"target_trade_id":"' + f_jsonEscape(targetTradeId) + '"' : ''
    string payload = '{"trade_id":"' + f_jsonEscape(id) + '","broker":"' + f_jsonEscape(rtBroker) + '","symbol":"' + f_jsonEscape(syminfo.ticker) + '","timeframe":"' + f_jsonEscape(timeframe.period) + '","event":"' + ev + '","side":"' + (ev == "BUY" ? "BUY" : "SELL") + '","account_type":"Spot","order_type":"MARKET","timestamp":' + str.tostring(stamp) + ',"reference_price":"' + str.tostring(px, format.mintick) + '","reduce_only":' + (ev == "BUY" ? "false" : "true") + ',"leverage":1,"volatility_percent":' + str.tostring(vol, "0.########") + ',"news_risk":' + (rtNews ? "true" : "false") + riskPart + targetPart + '}'
    payload

// Multi-entry tracking: bounded to max 10 entries per alert instance.
var string[] rtEntryIds = array.new_string()
var float[] rtEntryStops = array.new_float()
var float[] rtEntryTargets = array.new_float()
var int[] rtEntryBars = array.new_int()
var int rtLastHistoricalBuy = na
var int rtLastLiveBuy = na
var int rtLastHistoricalSell = na
var int rtLastLiveSell = na
var int rtLastLiveClose = na
var int rtAlertCalls = 0
var string rtLastDecision = "Waiting for a realtime BUY or SELL"
if buySignal and not barstate.isrealtime
    rtLastHistoricalBuy := time_close
if sellSignal and not barstate.isrealtime
    rtLastHistoricalSell := time_close
if barstate.isrealtime and barstate.isconfirmed
    rtLastLiveClose := time_close
    if buySignal
        rtLastLiveBuy := time_close
        if not rtEnabled
            rtLastDecision := not notifyEnabled ? "BUY skipped: notifications OFF" : "BUY skipped: select Robot Trade (Spot)"
    if sellSignal
        rtLastLiveSell := time_close
        if not rtEnabled
            rtLastDecision := not notifyEnabled ? "SELL skipped: notifications OFF" : "SELL skipped: select Robot Trade (Spot)"
// Exit takes priority on the same bar; never submit a new BUY behind a full exit.
f_rtCanBuy(bool signalBuy, bool trackingLong, bool repeatBuy, bool news, bool exitSent) =>
    signalBuy and (not trackingLong or repeatBuy) and not news and not exitSent
// The receiver owns actual holdings; SELL must not depend on Pine's BUY memory.
f_rtExitEvent(string protectiveExit, bool signalSell, bool sendSell) =>
    protectiveExit != "" ? protectiveExit : signalSell and sendSell ? "SELL" : ""
if rtEnabled and barstate.isrealtime and barstate.isconfirmed
    if na(time_close)
        runtime.error("Robot Trade: chart must provide a bar-close timestamp.")
    float rtPrice = math.round_to_mintick(close)
    float rtVol = na(atr) or close <= 0 ? 0.0 : 100.0 * atr / close
    string rtEvent = ""
    string rtTargetTradeId = ""

    // Check protective exits for tracked entries
    if array.size(rtEntryIds) > 0
        for i = array.size(rtEntryIds) - 1 to 0
            int entryBar = array.get(rtEntryBars, i)
            if bar_index > entryBar
                float entryStop = array.get(rtEntryStops, i)
                float entryTarget = array.get(rtEntryTargets, i)
                bool stopHit = low <= entryStop
                bool targetHit = high >= entryTarget
                if stopHit or targetHit
                    string ev = (stopHit and targetHit) ? (btSameBarMode == "Conservative" ? "SL" : "TP") : (stopHit ? "SL" : "TP")
                    string targetId = array.get(rtEntryIds, i)
                    alert(f_rtPayload(ev, rtPrice, na, na, rtVol, time_close, targetId), alert.freq_once_per_bar_close)
                    rtAlertCalls += 1
                    rtEvent := ev
                    rtTargetTradeId := targetId
                    rtLastDecision := ev + ": alert() called; check Alert Log"
                    array.remove(rtEntryIds, i)
                    array.remove(rtEntryStops, i)
                    array.remove(rtEntryTargets, i)
                    array.remove(rtEntryBars, i)

    rtEvent := f_rtExitEvent(rtEvent, sellSignal, rtExitOnSell)
    if rtEvent != ""
        if rtEvent == "SELL"
            alert(f_rtPayload("SELL", rtPrice, na, na, rtVol, time_close, ""), alert.freq_once_per_bar_close)
            rtAlertCalls += 1
            rtLastDecision := "SELL: alert() called; check Alert Log"
            array.clear(rtEntryIds)
            array.clear(rtEntryStops)
            array.clear(rtEntryTargets)
            array.clear(rtEntryBars)
        else if sellSignal and rtExitOnSell
            rtLastDecision := "SELL covered by " + rtEvent + ": one exit alert() called"
    else if sellSignal and not rtExitOnSell
        rtLastDecision := "SELL skipped: Send SELL disabled"
        if rtShowSkipped
            label.new(bar_index, high, "Robot SELL skipped: Send SELL disabled", style = label.style_label_down, color = color.orange, textcolor = color.black, size = size.small)

    bool trackingLong = array.size(rtEntryIds) > 0
    string rtSkip = ""
    if buySignal
        rtSkip := rtEvent != "" ? "Exit takes priority this bar" : rtNews ? "Manual news block enabled" : trackingLong and not rtRepeatBuy ? "Repeated BUY disabled" : array.size(rtEntryIds) >= 10 ? "Max 10 open entries reached" : ""
    if f_rtCanBuy(buySignal, trackingLong, rtRepeatBuy, rtNews, rtEvent != "") and array.size(rtEntryIds) < 10
        float nextStop = math.round_to_mintick(longSLPreview)
        float nextTarget = math.round_to_mintick(close + (close - longSLPreview) * f_targetRR())
        if rtPrice > 0 and not na(nextStop) and nextStop > 0 and nextStop < rtPrice and nextTarget > rtPrice and not na(atr)
            string buyId = "SPT-" + rtTag + "-" + syminfo.ticker + "-" + timeframe.period + "-" + str.tostring(time_close) + "-BUY"
            array.push(rtEntryIds, buyId)
            array.push(rtEntryStops, nextStop)
            array.push(rtEntryTargets, nextTarget)
            array.push(rtEntryBars, bar_index)
            alert(f_rtPayload("BUY", rtPrice, nextStop, nextTarget, rtVol, time_close, ""), alert.freq_once_per_bar_close)
            rtAlertCalls += 1
            rtLastDecision := "BUY: alert() called; check Alert Log"
        else
            rtSkip := "Invalid rounded SL/TP or ATR unavailable"
    if buySignal and rtSkip != ""
        rtLastDecision := "BUY skipped: " + rtSkip
        if rtShowSkipped
            label.new(bar_index, low, "Robot BUY skipped: " + rtSkip, style = label.style_label_up, color = color.orange, textcolor = color.black, size = size.small)

f_rtTime(int stamp) =>
    na(stamp) ? "None since chart load" : str.format_time(stamp, "yyyy-MM-dd HH:mm:ss", "UTC")

// Chart-local diagnostics cannot observe the saved alert instance or HTTP delivery.
var table rtStatus = table.new(position.bottom_left, 2, 10, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast and rtShowStatus
    string rtMode = not notifyEnabled ? "OFF: Enable notifications" : not rtEnabled ? "OFF: select Robot Trade (Spot)" : "ON: confirmed realtime bars only"
    table.cell(rtStatus, 0, 0, "Robot Bridge " + rtBuild, text_color = color.aqua, text_size = size.small)
    table.cell(rtStatus, 1, 0, "Chart instance / times UTC", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 0, 1, "Route", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 1, rtMode, text_color = rtEnabled ? color.lime : color.orange, text_size = size.small)
    table.cell(rtStatus, 0, 2, "Last realtime close", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 2, f_rtTime(rtLastLiveClose), text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 0, 3, "Last historical BUY", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 3, f_rtTime(rtLastHistoricalBuy), text_color = color.gray, text_size = size.small)
    table.cell(rtStatus, 0, 4, "Last realtime BUY", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 4, f_rtTime(rtLastLiveBuy), text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 0, 5, "Last historical SELL", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 5, f_rtTime(rtLastHistoricalSell), text_color = color.gray, text_size = size.small)
    table.cell(rtStatus, 0, 6, "Last realtime SELL", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 6, f_rtTime(rtLastLiveSell), text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 0, 7, "Last decision", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 7, rtLastDecision, text_color = color.yellow, text_size = size.small)
    table.cell(rtStatus, 0, 8, "alert() calls / chart load", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 8, str.tostring(rtAlertCalls), text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 0, 9, "Delivery confirmation", text_color = color.white, text_size = size.small)
    table.cell(rtStatus, 1, 9, "TradingView Alert Log / Robot Trade Log", text_color = color.white, text_size = size.small)
// ROBOT TRADE BRIDGE END
