)

f_dashPair(int row, int leftCol, string leftText, string rightText, color rightBg) =>
    table.cell(
         dash,
         leftCol,
         row,
         leftText,
         bgcolor = color.new(color.black, 0),
         text_color = color.white,
         text_size = dashTextSize
    )

    table.cell(
         dash,
         leftCol + 1,
         row,
         rightText,
         bgcolor = rightBg,
         text_color = color.white,
         text_size = dashTextSize
    )

